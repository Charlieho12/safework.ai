# Stripe Test Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys

# Stripe Publishable Key (for frontend) - Test Mode
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# OpenAI API Key
VITE_OPENAI_API_KEY=sk-...

# Stripe Webhook Secret (for webhook verification) - Get this from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# API Configuration
VITE_API_URL=http://localhost:3001/api

# App Configuration
VITE_APP_URL=http://localhost:5173

# Use mock payment (set to false to use real Stripe)
VITE_USE_MOCK_PAYMENT=true
